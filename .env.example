# Configure these in your hosting provider's private environment settings.
# For Supabase use a backend PostgreSQL connection, never an anonymous API key.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
APP_PASSWORD=replace-with-a-long-private-household-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
COOKIE_SECURE=true
